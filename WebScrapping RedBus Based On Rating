        text="Price",
        title="Bus Fare Comparison"
    )

    st.plotly_chart(
        price_chart,
        use_container_width=True
    )

# ------------------------------------------------------------
# DOWNLOAD
# ------------------------------------------------------------

if len(filtered) > 0:

    csv = filtered.to_csv(
        index=False
    )

    st.download_button(
        label="⬇️ Download Filtered Travels",
        data=csv,
        file_name="filtered_redbus_travels.csv",
        mime="text/csv"
    )

# ------------------------------------------------------------
# FOOTER
# ------------------------------------------------------------

st.markdown("---")

st.caption(
    "RedBus Travel Finder | "
    "Rating + Location Based Filtering"
)
'''

