app_code = r'''
import streamlit as st
import pandas as pd
import plotly.express as px

# ------------------------------------------------------------
# PAGE CONFIG
# ------------------------------------------------------------

st.set_page_config(
    page_title="RedBus Travel Finder",
    page_icon="🚌",
    layout="wide"
)

# ------------------------------------------------------------
# TITLE
# ------------------------------------------------------------

st.title("🚌 RedBus Travel Finder")

st.markdown(
    """
    ### Find Travels Based on Location and Rating

    Select your **From location**, **To location**, and
    **minimum rating** to find matching bus operators.
    """
)

# ------------------------------------------------------------
# LOAD DATA
# ------------------------------------------------------------

df = pd.read_csv("/content/redbus_data.csv")

# ------------------------------------------------------------
# SIDEBAR
# ------------------------------------------------------------

st.sidebar.header("🔎 Search Filters")

# FROM LOCATION

from_locations = sorted(
    df["From"].dropna().unique()
)

from_location = st.sidebar.selectbox(
    "📍 From Location",
    from_locations
)

# TO LOCATION

available_to = sorted(
    df[
        df["From"] == from_location
    ]["To"].dropna().unique()
)

to_location = st.sidebar.selectbox(
    "📍 To Location",
    available_to
)

# RATING

minimum_rating = st.sidebar.slider(
    "⭐ Minimum Rating",
    min_value=0.0,
    max_value=5.0,
    value=4.0,
    step=0.1
)

# TRAVEL

route_data = df[
    (df["From"] == from_location) &
    (df["To"] == to_location)
]

travel_options = [
    "All Travels"
] + sorted(
    route_data["Travel"].unique().tolist()
)

selected_travel = st.sidebar.selectbox(
    "🚌 Select Travel",
    travel_options
)

# ------------------------------------------------------------
# FILTER DATA
# ------------------------------------------------------------

filtered = df[
    (df["From"] == from_location) &
    (df["To"] == to_location) &
    (df["Rating"] >= minimum_rating)
].copy()

# Travel filter

if selected_travel != "All Travels":

    filtered = filtered[
        filtered["Travel"] == selected_travel
    ]

# ------------------------------------------------------------
# SUMMARY
# ------------------------------------------------------------

st.subheader("📊 Search Summary")

col1, col2, col3, col4 = st.columns(4)

with col1:
    st.metric(
        "Travels Found",
        len(filtered)
    )

with col2:

    if len(filtered) > 0:
        st.metric(
            "Highest Rating",
            f"{filtered['Rating'].max():.1f} ⭐"
        )
    else:
        st.metric(
            "Highest Rating",
            "-"
        )

with col3:

    if len(filtered) > 0:
        st.metric(
            "Average Rating",
            f"{filtered['Rating'].mean():.2f} ⭐"
        )
    else:
        st.metric(
            "Average Rating",
            "-"
        )

with col4:

    if len(filtered) > 0:
        st.metric(
            "Available Seats",
            int(filtered["Seats_Available"].sum())
        )
    else:
        st.metric(
            "Available Seats",
            0
        )

# ------------------------------------------------------------
# SELECTED ROUTE
# ------------------------------------------------------------

st.info(
    f"🚌 Route: **{from_location} → {to_location}**  |  "
    f"⭐ Rating ≥ **{minimum_rating:.1f}**"
)

# ------------------------------------------------------------
# RESULTS
# ------------------------------------------------------------

st.subheader("🚌 Available Travels")

if len(filtered) == 0:

    st.warning(
        "No travels found for the selected "
        "location and rating."
    )

else:

    # Sort by rating
    filtered = filtered.sort_values(
        by="Rating",
        ascending=False
    )

    # --------------------------------------------------------
    # DISPLAY EACH TRAVEL
    # --------------------------------------------------------

    for index, row in filtered.iterrows():

        with st.container(border=True):

            col1, col2, col3, col4 = st.columns(
                [3, 1.5, 2, 1.5]
            )

            with col1:

                st.markdown(
                    f"### 🚌 {row['Travel']}"
                )

                st.write(
                    f"📍 {row['From']} → {row['To']}"
                )

                st.write(
                    f"🛏️ {row['Bus_Type']}"
                )

            with col2:

                st.markdown(
                    f"## ⭐ {row['Rating']:.1f}"
                )

                st.write(
                    f"{row['Reviews']:,} reviews"
                )

            with col3:

                st.write(
                    f"🕐 **Departure:** "
                    f"{row['Departure']}"
                )

                st.write(
                    f"🕐 **Arrival:** "
                    f"{row['Arrival']}"
                )

                st.write(
                    f"💺 **Seats:** "
                    f"{row['Seats_Available']}"
                )

            with col4:

                st.markdown(
                    f"### ₹{row['Price']}"
                )

                if st.button(
                    "View / Book",
                    key=f"book_{index}"
                ):

                    st.success(
                        f"You selected "
                        f"{row['Travel']} "
                        f"for {row['From']} → "
                        f"{row['To']}"
