# 7. CLICK LOCATION
# ============================================================

def handle_map_click(**kwargs):

    global selected_lat
    global selected_lon
    global location_locked
    global selected_marker
    global scraping_running

    if kwargs.get("type") != "click":
        return

    # Prevent another selection
    if location_locked:
        return

    coordinates = kwargs.get("coordinates")

    if not coordinates:
        return

    selected_lat = float(coordinates[0])
    selected_lon = float(coordinates[1])

    location_locked = True

    # --------------------------------------------------------
    # ADD SELECTED LOCATION MARKER
    # --------------------------------------------------------

    selected_marker = Marker(
        location=(selected_lat, selected_lon),
        draggable=False
    )

    restaurant_map.add_layer(selected_marker)

    # --------------------------------------------------------
    # STOP FURTHER LOCATION SELECTION
    # --------------------------------------------------------

    restaurant_map.scroll_wheel_zoom = False

    # --------------------------------------------------------
    # SHOW LOCATION
    # --------------------------------------------------------

    google_url = create_google_maps_url(
        selected_lat,
        selected_lon
    )

    with status_output:

        clear_output(wait=True)

        display(HTML(f"""
        <div style="
            background:#e8f5e9;
            padding:18px;
            border-radius:10px;
            margin-top:15px;
        ">

        <h3>🔒 LOCATION LOCKED</h3>

        <b>Latitude:</b> {selected_lat:.6f}<br>
        <b>Longitude:</b> {selected_lon:.6f}

        <br><br>

        <a href="{google_url}"
           target="_blank"
           style="
           background:#4285F4;
           color:white;
           padding:12px 18px;
           text-decoration:none;
           border-radius:7px;
           font-weight:bold;
           display:inline-block;
           ">
           📍 Open Exact Location in Google Maps
        </a>

        <br><br>

        <b>🔎 Automatically searching for restaurants...</b>

        </div>
        """))

    # --------------------------------------------------------
    # START RESTAURANT SCRAPING
    # --------------------------------------------------------

    if not scraping_running:

        scraping_running = True

        thread = threading.Thread(
            target=search_restaurants,
            args=(selected_lat, selected_lon),
            daemon=True
        )

        thread.start()


