# ============================================================
# 15. EXTRACT WEBSITE
# ============================================================

def extract_website(driver):

    selectors = [

        "a[data-item-id='authority']",

        "a[aria-label*='Website']",

        "a[aria-label*='website']"

    ]

    for selector in selectors:

        try:

            elements = driver.find_elements(
                By.CSS_SELECTOR,
                selector
            )

            for element in elements:

                href = element.get_attribute(
                    "href"
                )

                if href:

                    return href

        except:
            pass

    return "Not Available"


# ============================================================
# 16. EXTRACT PRICE
# ============================================================

def extract_price(driver):

    try:

        body = driver.find_element(
            By.TAG_NAME,
            "body"
        ).text

        # Indian price symbols
        price_match = re.search(
            r"₹{1,4}",
            body
        )

        if price_match:

            return price_match.group(0)

        # Dollar fallback
        dollar_match = re.search(
            r"\${1,4}",
            body
        )

        if dollar_match:

            return dollar_match.group(0)

    except:
        pass

    return "Not Available"


# ============================================================
# 17. EXTRACT OPEN/CLOSED STATUS
# ============================================================

def extract_status(driver):

    try:

        body = driver.find_element(
            By.TAG_NAME,
            "body"
        ).text

        lines = [
            clean_text(x)
            for x in body.split("\n")
        ]

        for line in lines:

            if line.lower() == "open":
                return "Open"

            if line.lower() == "closed":
                return "Closed"

            if "temporarily closed" in line.lower():
                return "Temporarily Closed"

    except:
        pass

    return "Not Available"


# ============================================================
# 18. EXTRACT TIMINGS
# ============================================================

def extract_timings(driver):

    try:

        rows = driver.find_elements(
            By.CSS_SELECTOR,
            "table tr"
        )

        timings = []

        for row in rows:

            text = clean_text(
                row.text
            )

            if text != "Not Available":

                timings.append(text)

        if timings:

            return " | ".join(timings)

    except:
        pass

    return "Not Available"


