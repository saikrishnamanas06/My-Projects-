def add_restaurant_markers(data):

    global restaurant_markers

    # Remove previous restaurant markers
    for marker in restaurant_markers:

        try:

            restaurant_map.remove_layer(
                marker
            )

        except:
            pass

    restaurant_markers = []


    for item in data:

        lat = item.get(
            "Latitude"
        )

        lon = item.get(
            "Longitude"
        )

        # Don't put fake markers at
        # selected location
        if lat is None or lon is None:

            continue


        # ----------------------------------------------------
        # POPUP CONTENT
        # ----------------------------------------------------

        popup_html = f"""

        <div style="
            width:300px;
            font-family:Arial;
        ">

        <h3>
        🍽️ {item.get("Restaurant Name")}
        </h3>

        <hr>

        <b>📍 Location:</b><br>
        {item.get("Location / Address")}

        <br><br>

        <b>⭐ Rating:</b>
        {item.get("Rating")}

        <br>

        <b>💬 Reviews:</b>
        {item.get("Reviews")}

        <br>

        <b>💰 Price:</b>
