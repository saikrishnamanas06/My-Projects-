reset_button = Button(
    description="🔄 Reset Location",
    button_style="warning"
)


def reset_location(button):

    global location_locked
    global selected_lat
    global selected_lon
    global selected_marker
    global restaurants

    location_locked = False

    selected_lat = None
    selected_lon = None

    restaurants = []

    if selected_marker:

        try:

            restaurant_map.remove_layer(
                selected_marker
            )

        except:
            pass

        selected_marker = None


    for marker in restaurant_markers:

        try:

            restaurant_map.remove_layer(
                marker
            )

        except:
            pass


    restaurant_markers.clear()


    with status_output:

        clear_output(wait=True)

        display(
            HTML(
                """
                <h3>
                🔄 Ready for a new location
                </h3>

                <p>
                Click ONE location on the map.
                </p>
                """
            )
        )


reset_button.on_click(
    reset_location
)


display(reset_button)


