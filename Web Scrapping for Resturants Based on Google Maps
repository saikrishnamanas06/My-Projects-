# 22. SEARCH RESTAURANTS AUTOMATICALLY
# ============================================================

def search_restaurants(latitude, longitude):

    global restaurants
    global scraping_running

    with search_lock:

        driver = None

        try:

            print("\n" + "=" * 90)
            print("🔎 RESTAURANT SEARCH")
            print("=" * 90)

            print(
                f"📍 Latitude : {latitude}"
            )

            print(
                f"📍 Longitude: {longitude}"
            )

            print(
                "🔒 Using ONLY this fixed location."
            )

            print(
                "🍽️ Searching automatically for restaurants..."
            )

            # ------------------------------------------------
            # GOOGLE MAPS RESTAURANT SEARCH
            # ------------------------------------------------

            search_url = (
                "https://www.google.com/maps/search/"
                f"restaurants/@{latitude},{longitude},15z"
            )

            print(
                "\n🌐 Google Maps Search:"
            )

            print(search_url)

            driver = create_driver()

            driver.get(search_url)

            # ------------------------------------------------
            # WAIT FOR RESULTS
            # ------------------------------------------------

            try:

                WebDriverWait(
                    driver,
                    25
                ).until(
                    EC.presence_of_element_located(
                        (
                            By.CSS_SELECTOR,
                            "div[role='feed']"
                        )
                    )
                )

            except:

                print(
                    "⚠️ Restaurant feed was not detected."
                )


            time.sleep(4)


            # ------------------------------------------------
            # SCROLL GOOGLE MAPS RESULTS
            # ------------------------------------------------

            try:

                feed = driver.find_element(
                    By.CSS_SELECTOR,
                    "div[role='feed']"
                )

                previous_count = 0

                for i in range(8):

                    driver.execute_script(
                        """
                        arguments[0].scrollTop =
                        arguments[0].scrollHeight;
                        """,
                        feed
                    )

                    time.sleep(2)

                    anchors = driver.find_elements(
                        By.CSS_SELECTOR,
                        "div[role='feed'] "
                        "a[href*='/maps/place/']"
                    )

                    current_count = len(anchors)

                    print(
                        f"📜 Scroll {i+1}/8 "
                        f"| Restaurants found: "
                        f"{current_count}"
                    )

                    if current_count == previous_count:

                        break

                    previous_count = current_count

            except Exception as e:

                print(
                    "⚠️ Feed scrolling issue:",
                    e
                )


            # ------------------------------------------------
            # GET RESTAURANT LINKS
            # ------------------------------------------------

            anchors = driver.find_elements(
                By.CSS_SELECTOR,
                "div[role='feed'] "
                "a[href*='/maps/place/']"
            )

            urls = []

            for anchor in anchors:

                try:

                    href = anchor.get_attribute(
                        "href"
                    )

                    if href and "/maps/place/" in href:

                        urls.append(href)

                except:
                    pass


            # ------------------------------------------------
            # REMOVE DUPLICATES
            # ------------------------------------------------

            urls = list(
                dict.fromkeys(urls)
            )


            # Limit number
            MAX_RESTAURANTS = 20

            urls = urls[
                :MAX_RESTAURANTS
            ]


            print(
                f"\n🍽️ Unique restaurant listings: "
                f"{len(urls)}"
            )


            # ------------------------------------------------
            # EXTRACT DETAILS
            # ------------------------------------------------

            restaurants = []

            for index, url in enumerate(
                urls,
                start=1
            ):

                print(
                    f"\n[{index}/{len(urls)}] "
                    f"Extracting restaurant..."
                )

                data = extract_restaurant(
                    driver,
                    url
                )

                if not data:
                    continue

                # If Google didn't expose
                # restaurant-specific coordinates,
                # don't falsely invent them.
                if (
                    data["Latitude"] is None
                    or data["Longitude"] is None
                ):

                    data["Latitude"] = None
                    data["Longitude"] = None


                restaurants.append(data)


                print(
                    "   🍽️",
                    data["Restaurant Name"]
                )

                print(
                    "   ⭐",
                    data["Rating"]
                )

                print(
                    "   💰",
                    data["Price"]
                )

                print(
                    "   📞",
                    data["Phone Number"]
                )


            # ------------------------------------------------
            # REMOVE DUPLICATE RESTAURANTS
            # ------------------------------------------------

            unique = {}

            for item in restaurants:

                key = (
                    item["Restaurant Name"]
                    + "|"
                    + item["Location / Address"]
                )

                unique[key] = item

            restaurants = list(
                unique.values()
            )


            # ------------------------------------------------
            # CREATE DATAFRAME
            # ------------------------------------------------

            df = pd.DataFrame(
                restaurants
            )


            # ------------------------------------------------
            # SHOW RESULT
            # ------------------------------------------------

            print("\n" + "=" * 90)
            print("✅ RESTAURANT DATABASE READY")
            print("=" * 90)

            print(
                f"🍽️ Total restaurants: "
                f"{len(df)}"
            )


            with status_output:

                clear_output(wait=True)

                display(
                    HTML(
                        f"""
                        <div style="
                        background:#e8f5e9;
                        padding:18px;
                        border-radius:10px;
                        ">

                        <h2>
                        🍽️ Restaurant Search Completed
                        </h2>

                        <b>Selected Location</b><br>

                        Latitude:
                        {latitude:.6f}<br>

                        Longitude:
                        {longitude:.6f}

                        <br><br>

                        <b>
                        🍽️ Restaurants Found:
                        {len(df)}
                        </b>

                        </div>
                        """
                    )
                )


                if not df.empty:

                    display(
                        df
                    )

                else:

                    display(
                        HTML(
                            """
                            <h3>
                            ⚠️ No restaurant data
                            was extracted.
                            </h3>

                            <p>
                            Google Maps may have changed
                            its page structure or blocked
                            automated requests.
                            </p>
                            """
                        )
                    )


            # ------------------------------------------------
            # ADD RESTAURANT MARKERS
            # ------------------------------------------------

            add_restaurant_markers(
                restaurants
            )


            # ------------------------------------------------
            # EXPORT
            # ------------------------------------------------

            if not df.empty:

                df.to_csv(
                    "/content/restaurants.csv",
                    index=False
                )

                df.to_excel(
                    "/content/restaurants.xlsx",
                    index=False
                )


                display(
                    HTML(
                        """
                        <br>

                        <a href="/files/restaurants.csv"
                           target="_blank"
                           style="
                           background:#2e7d32;
                           color:white;
                           padding:10px 15px;
                           text-decoration:none;
                           border-radius:6px;
                           margin-right:10px;
                           ">
                           📥 Download CSV
                        </a>

                        <a href="/files/restaurants.xlsx"
                           target="_blank"
                           style="
                           background:#1565c0;
                           color:white;
                           padding:10px 15px;
                           text-decoration:none;
                           border-radius:6px;
                           ">
                           📥 Download Excel
                        </a>
                        """
