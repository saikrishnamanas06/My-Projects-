def extract_famous_food(driver):

    food_keywords = [

        "biryani",
        "pizza",
        "burger",
        "dosa",
        "masala dosa",
        "idli",
        "vada",
        "thali",
        "fried rice",
        "noodles",
        "momos",
        "shawarma",
        "kebab",
        "tandoori",
        "paneer",
        "butter chicken",
        "chole bhature",
        "paratha",
        "pav bhaji",
        "ice cream",
        "cake",
        "coffee",
        "tea",
        "sandwich",
        "pasta",
        "rolls",
        "dessert"
    ]

    try:

        body = driver.find_element(
            By.TAG_NAME,
            "body"
        ).text.lower()

        found = []

        for food in food_keywords:

            if food in body:

