            )

    except:
        pass

    return "Not Available"


# ============================================================
# 20. EXTRACT RESTAURANT COORDINATES
# ============================================================

def extract_coordinates(driver):

    urls_to_check = [

        driver.current_url,

    ]

    try:

        urls_to_check.append(
            driver.page_source
        )

    except:
        pass

    patterns = [

        r"/@(-?\d+\.\d+),(-?\d+\.\d+)",

        r"!3d(-?\d+\.\d+)!4d(-?\d+\.\d+)",

        r"center=(-?\d+\.\d+)%2C(-?\d+\.\d+)",

    ]

    for content in urls_to_check:

        for pattern in patterns:

            match = re.search(
                pattern,
                content
            )

            if match:

                return (
                    float(match.group(1)),
                    float(match.group(2))
                )

    return None, None


# ============================================================
# 21. EXTRACT ONE RESTAURANT
# ============================================================

def extract_restaurant(driver, url):

    try:

        driver.get(url)

        WebDriverWait(
            driver,
            15
        ).until(
            EC.presence_of_element_located(
                (By.TAG_NAME, "h1")
            )
        )

        time.sleep(2)

    except:

        return None


    # --------------------------------------------------------
    # NAME
    # --------------------------------------------------------

    name = get_first_text(
        driver,
        [
            "h1.DUwDvf",
            "h1.fontHeadlineLarge",
            "h1"
        ]
    )


    # --------------------------------------------------------
    # OTHER DATA
    # --------------------------------------------------------

    address = extract_address(driver)

    category = extract_category(driver)

    phone = extract_phone(driver)

    price = extract_price(driver)

    status = extract_status(driver)

    timings = extract_timings(driver)

    website = extract_website(driver)

    famous_food = extract_famous_food(driver)

    rating, reviews = extract_rating_reviews(
        driver
    )

    latitude, longitude = extract_coordinates(
        driver
    )


    # --------------------------------------------------------
    # GOOGLE MAPS URL
    # --------------------------------------------------------

    maps_url = driver.current_url


    # --------------------------------------------------------
    # RETURN DATA
    # --------------------------------------------------------

    return {

        "Restaurant Name": name,

        "Location / Address": address,

        "Category": category,

        "Rating": rating,

        "Reviews": reviews,

        "Price": price,

        "Phone Number": phone,

        "Status": status,

        "Timings": timings,

        "Famous Food": famous_food,

        "Website": website,

        "Latitude": latitude,

        "Longitude": longitude,

        "Google Maps URL": maps_url
    }


