        popup = Popup(
            location=(lat, lon),
            child=WidgetHTML(
                value=popup_html
            ),
            close_button=True,
            auto_close=True
        )


        marker = Marker(
            location=(lat, lon),
            draggable=False
        )

        marker.popup = popup


        restaurant_map.add_layer(
            marker
        )

        restaurant_markers.append(
            marker
        )


