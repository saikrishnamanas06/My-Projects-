SESSIONS = {}


def get_session(session_id):

    if session_id not in SESSIONS:

        SESSIONS[session_id] = {
            "intent": None,
            "location": None,
            "date": None,
            "time": None,
            "guests": None,
            "preference": None,
            "restaurant": None,
            "customer": {},
            "payment": {}
        }

    return SESSIONS[session_id]


# ============================================================
# TEXT EXTRACTION
# ============================================================

def extract_location(text):

    locations = [
        "Banjara Hills",
        "Jubilee Hills",
        "HITEC City",
        "Madhapur",
        "Begumpet",
        "Secunderabad",
        "Hyderabad"
    ]

    text_lower = text.lower()

    for location in locations:

        if location.lower() in text_lower:
            return location

    return None


def extract_guests(text):

    patterns = [
        r'(\d+)\s*people',
        r'(\d+)\s*persons',
        r'(\d+)\s*guests',
        r'for\s+(\d+)',
        r'party\s+of\s+(\d+)'
    ]

    for pattern in patterns:

        match = re.search(pattern, text.lower())

        if match:

            number = int(match.group(1))

            if 1 <= number <= 100:
                return number

    return None


def extract_time(text):

    text_lower = text.lower()

    match = re.search(
        r'(\d{1,2})(?::(\d{2}))?\s*(am|pm)',
        text_lower
    )

    if match:

        hour = match.group(1)
        minute = match.group(2) or "00"
        period = match.group(3).upper()

        return f"{hour}:{minute} {period}"

    if "tonight" in text_lower:
        return "Tonight"

    if "evening" in text_lower:
        return "Evening"

    if "night" in text_lower:
        return "Night"

    if "afternoon" in text_lower:
        return "Afternoon"

    if "morning" in text_lower:
        return "Morning"

    return None


def extract_date(text):

    text_lower = text.lower()

    if "tonight" in text_lower:
        return "Tonight"

    if "today" in text_lower:
        return "Today"

    if "tomorrow" in text_lower:
        return "Tomorrow"

    return None


def extract_preference(text):

    text_lower = text.lower()

    if any(word in text_lower for word in [
        "non veg",
        "non-veg",
        "nonveg",
        "chicken",
        "mutton",
        "meat"
    ]):
        return "Non-Veg"

    if any(word in text_lower for word in [
        "veg",
        "vegetarian"
    ]):
        return "Veg"

    return None


# ============================================================
# RESTAURANT SEARCH
# ============================================================

def search_restaurants(session):

    results = []

    location = session["location"]
    preference = session["preference"]

    for restaurant in RESTAURANTS:

        if location:

            if restaurant["location"].lower() != location.lower():

                continue

        if preference == "Veg" and not restaurant["veg"]:
            continue

        if preference == "Non-Veg" and not restaurant["nonveg"]:
            continue

        results.append(restaurant)

    return results


# ============================================================
# CHAT RESPONSE ENGINE
# ============================================================

@app.route("/chat", methods=["POST"])
def chat():

    data = request.json

    session_id = data.get("session_id")
    message = data.get("message", "").strip()

    session = get_session(session_id)

    if not message:

        return jsonify({
            "type": "message",
            "message": "Please enter your request."
        })

    text = message.lower()

    # --------------------------------------------------------
    # DETECT RESTAURANT INTENT
    # --------------------------------------------------------

    if any(word in text for word in [
        "restaurant",
        "table",
        "dinner",
        "lunch",
        "bbq",
        "barbecue",
        "book a table"
    ]):

        session["intent"] = "restaurant"

    # --------------------------------------------------------
    # EXTRACT DETAILS
    # --------------------------------------------------------

    location = extract_location(message)

    if location:
        session["location"] = location

    guests = extract_guests(message)

    if guests:
        session["guests"] = guests

    date = extract_date(message)

    if date:
        session["date"] = date

    selected_time = extract_time(message)

    if selected_time:
        session["time"] = selected_time

    preference = extract_preference(message)

    if preference:
        session["preference"] = preference

    # --------------------------------------------------------
    # ASK MISSING INFORMATION
    # --------------------------------------------------------

    if session["intent"] == "restaurant":

        if not session["location"]:

            return jsonify({
                "type": "question",
                "agent": "Restaurant Booking Agent",
                "message":
                    "Sure! Which location would you like to book the restaurant in?",
                "field": "location",
                "suggestions": [
                    "Banjara Hills",
                    "Jubilee Hills",
                    "Madhapur",
                    "HITEC City"
                ]
            })

        if not session["date"]:

            return jsonify({
                "type": "question",
                "agent": "Restaurant Booking Agent",
                "message":
                    "What date would you like to visit?",
                "field": "date",
                "suggestions": [
                    "Today",
                    "Tomorrow",
                    "Tonight"
                ]
            })

        if not session["time"]:

            return jsonify({
                "type": "question",
                "agent": "Restaurant Booking Agent",
                "message":
                    "What time would you prefer?",
                "field": "time",
                "suggestions": [
                    "7:00 PM",
                    "8:00 PM",
                    "9:00 PM"
                ]
            })

        if not session["guests"]:

            return jsonify({
                "type": "question",
                "agent": "Restaurant Booking Agent",
                "message":
                    "How many people will be joining?",
                "field": "guests",
                "suggestions": [
                    "2",
                    "4",
                    "6"
                ]
            })

        if not session["preference"]:

            return jsonify({
                "type": "question",
                "agent": "Restaurant Booking Agent",
                "message":
                    "Do you prefer Vegetarian or Non-Vegetarian food?",
                "field": "preference",
                "suggestions": [
                    "Veg",
                    "Non-Veg"
                ]
            })

        # ----------------------------------------------------
        # ALL DETAILS AVAILABLE
        # ----------------------------------------------------

        results = search_restaurants(session)

        return jsonify({
            "type": "results",
            "agent": "Restaurant Booking Agent",
            "message":
                "Perfect. I have all the details. Here are the available sample restaurants.",
            "details": {
                "location": session["location"],
                "date": session["date"],
                "time": session["time"],
                "guests": session["guests"],
                "preference": session["preference"]
            },
            "results": results
        })

    return jsonify({
        "type": "message",
        "agent": "Universal Booking Agent",
        "message":
            "I can currently handle restaurant booking in this demo. Try: 'I want to book a restaurant'."
    })


