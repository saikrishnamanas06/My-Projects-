<script>

let sessionId =
    "SESSION-" +
    Date.now() +
    "-" +
    Math.floor(Math.random() * 100000);

let selectedRestaurant = null;

let selectedPaymentMethod = "UPI";


const chat =
    document.getElementById("chat");

const input =
    document.getElementById("messageInput");

const sendButton =
    document.getElementById("sendButton");


// =========================================================
// ADD MESSAGE
// =========================================================

function addMessage(text, type, agent="") {

    const div =
        document.createElement("div");

    div.className =
        "message " + type;

    if (type === "bot") {

        div.innerHTML =

            (agent
                ? `<div class="agent">🤖 ${agent}</div>`
                : "") +

            text;

    } else {

        div.innerHTML =
            text;

    }

    chat.appendChild(div);

    window.scrollTo({
        top: document.body.scrollHeight,
        behavior: "smooth"
    });
}


// =========================================================
// SEND MESSAGE
// =========================================================

async function sendMessage() {

    const message =
        input.value.trim();

    if (!message)
        return;

    addMessage(
        message,
        "user"
    );

    input.value = "";

    addMessage(
        '<span class="typing">AI Agent is thinking...</span>',
        "bot"
    );

    const typingMessage =
        chat.lastElementChild;

    try {

        const response =
            await fetch("/chat", {

                method: "POST",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body: JSON.stringify({

                    session_id:
                        sessionId,

                    message:
                        message
                })

            });

        const data =
            await response.json();

        typingMessage.remove();

        processResponse(data);

    } catch(error) {

        typingMessage.remove();

        addMessage(
            "⚠️ Connection error. Please try again.",
            "bot",
            "System"
        );

        console.error(error);
    }
}


sendButton.addEventListener(
    "click",
    sendMessage
);


input.addEventListener(
    "keydown",
    function(event) {

        if (event.key === "Enter") {

            event.preventDefault();

            sendMessage();
        }

    }
);


// =========================================================
// PROCESS RESPONSE
// =========================================================

function processResponse(data) {

    if (data.type === "question") {

        let html =
            data.message;

        if (data.suggestions) {

            html +=
                '<div class="quick">';

            data.suggestions.forEach(
                function(item) {

                    html += `
                        <button
                            type="button"
                            onclick="quickAnswer('${item}')"
                        >
                            ${item}
                        </button>
                    `;

                }
            );

            html +=
                "</div>";
        }

        addMessage(
            html,
            "bot",
            data.agent
        );

    }

    else if (data.type === "results") {

        let html =
            data.message;

        const d =
            data.details;

        html += `

            <div class="detail-box">

                <div class="detail">
                    <small>📍 Location</small>
                    <strong>${d.location}</strong>
                </div>

                <div class="detail">
                    <small>📅 Date</small>
                    <strong>${d.date}</strong>
                </div>

                <div class="detail">
                    <small>🕐 Time</small>
                    <strong>${d.time}</strong>
                </div>

                <div class="detail">
                    <small>👥 Guests</small>
                    <strong>${d.guests}</strong>
                </div>

                <div class="detail">
                    <small>🍽️ Preference</small>
                    <strong>${d.preference}</strong>
                </div>

            </div>

        `;

        html +=
            '<div class="restaurant-grid">';

        data.results.forEach(
            function(r) {

                html += `

                    <div class="restaurant-card">

                        <h3>
                            🍽️ ${r.name}
                        </h3>

                        <div class="meta">
                            📍 ${r.location},
                            ${r.city}
                        </div>

                        <div class="meta">
                            🍴 ${r.cuisine}
                        </div>

                        <div class="meta">
                            ⭐ ${r.rating}
                            &nbsp;&nbsp;
                            ${r.price}
                        </div>

                        <div class="meta">
                            🕐 ${r.timings}
                        </div>

                        <button
                            class="book-btn"
                            type="button"
                            onclick='openBooking(${JSON.stringify(r)})'
                        >
                            Book Now →
                        </button>

                    </div>

                `;

            }
        );

        html +=
            "</div>";

        addMessage(
            html,
            "bot",
            data.agent
        );

    }

    else {

        addMessage(
            data.message || "Done.",
            "bot",
            data.agent || "AI Agent"
        );
    }
}


// =========================================================
// QUICK ANSWER
// =========================================================

function quickAnswer(value) {

    input.value =
        value;

    sendMessage();
}


// =========================================================
// OPEN BOOKING
// =========================================================

function openBooking(restaurant) {

    selectedRestaurant =
        restaurant;

    document.getElementById(
        "selectedRestaurant"
    ).innerHTML = `

        <div class="payment-summary">

            <b>${restaurant.name}</b>

            <br>

            📍 ${restaurant.location},
            ${restaurant.city}

            <br>

            ⭐ ${restaurant.rating}

        </div>

    `;

    document.getElementById(
        "bookingModal"
    ).classList.add("show");
}


// =========================================================
// CLOSE MODAL
// =========================================================

function closeModal(id) {

    document.getElementById(id)
        .classList.remove("show");
}


// =========================================================
// CUSTOMER DETAILS
// =========================================================

async function saveCustomerDetails() {

    const name =
        document.getElementById(
            "customerName"
        ).value.trim();

    const phone =
        document.getElementById(
            "customerPhone"
        ).value.trim();

    const email =
        document.getElementById(
            "customerEmail"
        ).value.trim();

    const specialRequest =
        document.getElementById(
            "specialRequest"
        ).value.trim();


    if (!name) {

        alert(
            "Please enter your full name."
        );

        return;
    }

    if (!phone) {

        alert(
            "Please enter your phone number."
        );

        return;
    }


    try {

        const response =
            await fetch(
                "/customer-details",
                {

                    method:
                        "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({

                            session_id:
                                sessionId,

                            name:
                                name,

                            phone:
                                phone,

                            email:
                                email,

                            special_request:
                                specialRequest

                        })

                }
            );

        const data =
            await response.json();


        if (!data.success) {

            alert(
                data.message
            );

            return;
        }


        closeModal(
            "bookingModal"
        );

        document.getElementById(
            "paymentModal"
        ).classList.add("show");


    } catch(error) {

        alert(
            "Unable to continue. Please try again."
        );

        console.error(error);
    }
}


// =========================================================
// PAYMENT METHOD
// =========================================================

function selectPayment(element) {

    document
        .querySelectorAll(
            ".payment-option"
        )
        .forEach(
            function(item) {

                item.classList.remove(
                    "selected"
                );

            }
        );

    element.classList.add(
        "selected"
    );

    selectedPaymentMethod =
        element.dataset.method;
}


// =========================================================
// MAKE PAYMENT
// =========================================================

async function makePayment() {

    try {

        const response =
            await fetch(
                "/payment",
                {

                    method:
                        "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({

                            session_id:
                                sessionId,

                            method:
                                selectedPaymentMethod

                        })

                }
            );

        const data =
            await response.json();


        if (!data.success) {

            alert(
                data.message
            );

            return;
        }


        closeModal(
            "paymentModal"
        );


        await confirmBooking();


    } catch(error) {

        alert(
            "Payment failed."
        );

        console.error(error);
    }
}


// =========================================================
// FINAL CONFIRMATION
// =========================================================

async function confirmBooking() {

    try {

        const response =
            await fetch(
                "/confirm-booking",
                {

                    method:
                        "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({

                            session_id:
                                sessionId

                        })

                }
            );

        const data =
            await response.json();


        if (!data.success) {

            alert(
                data.message
            );

            return;
        }


        const b =
            data.booking;

        const c =
            b.customer;

        const p =
            b.payment;


        document.getElementById(
            "confirmationContent"
        ).innerHTML = `

            <div class="success">

                <div class="success-icon">
                    ✓
                </div>

                <h2>
                    Booking Confirmed
                </h2>

                <span class="badge">
                    CONFIRMED
                </span>

                <div class="booking-detail">

                    <div class="booking-row">
                        <span>Restaurant</span>
                        <b>${b.restaurant}</b>
                    </div>

                    <div class="booking-row">
                        <span>Location</span>
                        <b>${b.location}</b>
                    </div>

                    <div class="booking-row">
                        <span>Date</span>
                        <b>${b.date}</b>
                    </div>

                    <div class="booking-row">
                        <span>Time</span>
                        <b>${b.time}</b>
                    </div>

                    <div class="booking-row">
                        <span>Guests</span>
                        <b>${b.guests}</b>
                    </div>

                    <div class="booking-row">
                        <span>Preference</span>
                        <b>${b.preference}</b>
                    </div>

                    <div class="booking-row">
                        <span>Name</span>
                        <b>${c.name}</b>
                    </div>

                    <div class="booking-row">
                        <span>Phone</span>
                        <b>${c.phone}</b>
                    </div>

                    <div class="booking-row">
                        <span>Payment</span>
                        <b>
                            ₹${p.amount}
                            — ${p.status}
                        </b>
                    </div>

                    <div class="booking-row">
                        <span>Transaction ID</span>
                        <b>${p.transaction_id}</b>
                    </div>

                    <div class="booking-row">
                        <span>Booking ID</span>
                        <b>${b.booking_id}</b>
                    </div>

                </div>

                <div class="demo">

                    🧪 <b>DEMO BOOKING</b>

                    <br><br>

                    This booking was generated
                    using the local sample database.

                    <br>

                    No real restaurant reservation
                    was created.

                    <br>

                    No real money was charged.

                </div>

                <button
                    class="primary"
                    type="button"
                    onclick="closeModal('confirmationModal')"
                >
                    Done
                </button>

            </div>

        `;


        document.getElementById(
            "confirmationModal"
        ).classList.add("show");


    } catch(error) {

        alert(
            "Unable to confirm booking."
        );

        console.error(error);
    }
}

</script>

</body>

</html>
"""


