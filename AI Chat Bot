def send_message(button=None):

    global message_count

    question = message_box.value.strip()

    if not question:

        return

    message_box.value = ""

    send_button.disabled = True

    show_user_message(question)

    with chat_output:

        loading = HTML(
            """
            <div style="
                padding:10px;
                color:#64748b;
                font-style:italic;
            ">
                🤖 AI is thinking...
            </div>
            """
        )

        display(loading)

    try:

        answer = generate_response(
            question
        )

        show_ai_message(answer)

        message_count += 1

        counter.value = (
            "<b>Messages:</b> "
            + str(message_count)
        )

    except Exception as error:

        show_ai_message(
            "⚠️ Error: " + str(error)
        )

    finally:

        send_button.disabled = False


