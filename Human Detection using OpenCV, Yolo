# ============================================================
# STEP 19 : VIDEO DETECTION
# ============================================================

print("\nUpload Video For Human Detection")

uploaded_video=files.upload()

if len(uploaded_video)>0:

    VIDEO=list(uploaded_video.keys())[0]

    OUTPUT=PROJECT+"/human_detection_output.mp4"

    cap=cv2.VideoCapture(VIDEO)

    fps=cap.get(cv2.CAP_PROP_FPS)

    if fps<=0:
        fps=25

    width=int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    height=int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))

    fourcc=cv2.VideoWriter_fourcc(*"mp4v")

    writer=cv2.VideoWriter(
        OUTPUT,
        fourcc,
        fps,
        (width,height)
    )

    print("Processing Video...")

    while True:

        ret,frame=cap.read()

        if not ret:
            break

        results=human_model.predict(
            source=frame,
            conf=0.35,
            imgsz=640,
            verbose=False
        )

        result=results[0]

        annotated=result.plot()

        count=len(result.boxes) if result.boxes is not None else 0

        cv2.rectangle(
            annotated,
            (10,10),
            (300,65),
            (0,0,0),
            -1
        )

        cv2.putText(
            annotated,
            f"Humans : {count}",
            (20,50),
            cv2.FONT_HERSHEY_SIMPLEX,
            1,
            (0,255,0),
            3
        )

        writer.write(annotated)

    cap.release()

    writer.release()

    print("\nVideo Completed")

    display(Video(OUTPUT,embed=True,width=850))

