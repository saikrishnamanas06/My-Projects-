# ============================================================
# STEP 7 : LOAD PRETRAINED YOLO
# ============================================================

print("\nLoading YOLO11...")

base_model=YOLO("yolo11n.pt")

print("YOLO Loaded Successfully")

# ============================================================
# STEP 8 : CREATE YOLO FOLDERS
# ============================================================

if os.path.exists(YOLO_DATASET):
    shutil.rmtree(YOLO_DATASET)

os.makedirs(TRAIN_IMG)
os.makedirs(VAL_IMG)
os.makedirs(TRAIN_LBL)
os.makedirs(VAL_LBL)

# ============================================================
# STEP 9 : TRAIN VALID SPLIT
# ============================================================

random.seed(42)

random.shuffle(images)

split=int(len(images)*0.8)

train_files=images[:split]

val_files=images[split:]

print("\nTraining Images :",len(train_files))
print("Validation Images :",len(val_files))

# ============================================================
# STEP 10 : CREATE YOLO LABEL FUNCTION
# ============================================================

def create_label(img_path,img_out,lbl_out):

    image=cv2.imread(str(img_path))

    if image is None:
        return 0

    h,w=image.shape[:2]

    results=base_model.predict(
        source=image,
        conf=0.35,
        imgsz=640,
        verbose=False,
        device=DEVICE
    )

    result=results[0]

    lines=[]

    if result.boxes is not None:

        for box in result.boxes:

            cls=int(box.cls[0])

            if cls!=0:
                continue

            x1,y1,x2,y2=box.xyxy[0].cpu().numpy()

            x1=max(0,min(x1,w))
            y1=max(0,min(y1,h))
            x2=max(0,min(x2,w))
            y2=max(0,min(y2,h))

            bw=x2-x1
            bh=y2-y1

            if bw<2 or bh<2:
                continue

            xc=((x1+x2)/2)/w
            yc=((y1+y2)/2)/h

            nw=bw/w
            nh=bh/h

            lines.append(
                f"0 {xc:.6f} {yc:.6f} {nw:.6f} {nh:.6f}"
            )

    shutil.copy2(
        str(img_path),
        os.path.join(img_out,img_path.name)
    )

    label=os.path.join(
        lbl_out,
        img_path.stem+".txt"
    )

    with open(label,"w") as f:
        f.write("\n".join(lines))

    return len(lines)

# ============================================================
# STEP 11 : GENERATE TRAIN LABELS
# ============================================================

print("\nGenerating Training Labels...")

train_boxes=0

for img in tqdm(train_files):
    train_boxes+=create_label(
        img,
        TRAIN_IMG,
        TRAIN_LBL
    )

print("Training Boxes :",train_boxes)

# ============================================================
# STEP 12 : GENERATE VALIDATION LABELS
# ============================================================

print("\nGenerating Validation Labels...")

val_boxes=0

for img in tqdm(val_files):
    val_boxes+=create_label(
        img,
        VAL_IMG,
        VAL_LBL
    )

print("Validation Boxes :",val_boxes)

# ============================================================
# STEP 13 : DATA YAML
# ============================================================

yaml_data={
    "path":YOLO_DATASET,
    "train":"images/train",
    "val":"images/val",
    "names":{
        0:"person"
    }
}

DATA_YAML=YOLO_DATASET+"/data.yaml"

with open(DATA_YAML,"w") as f:
    yaml.dump(yaml_data,f)

print("\nDATA YAML CREATED")

print(open(DATA_YAML).read())

# ============================================================
# STEP 14 : SHOW SAMPLE LABEL
# ============================================================

sample=random.choice(train_files)

img=cv2.imread(str(sample))

img=cv2.cvtColor(img,cv2.COLOR_BGR2RGB)

h,w=img.shape[:2]

label_file=Path(TRAIN_LBL)/(sample.stem+".txt")

if label_file.exists():

    with open(label_file) as f:
        labels=f.readlines()

    for line in labels:

        p=line.split()

        _,xc,yc,bw,bh=map(float,p)

        x1=int((xc-bw/2)*w)
        y1=int((yc-bh/2)*h)

        x2=int((xc+bw/2)*w)
        y2=int((yc+bh/2)*h)

        cv2.rectangle(
            img,
            (x1,y1),
            (x2,y2),
            (255,0,0),
            3
        )

plt.figure(figsize=(10,8))

plt.imshow(img)

plt.axis("off")

plt.title("Generated Human Bounding Box")

plt.show()

# ============================================================
# STEP 15 : TRAIN YOLO
# ============================================================

print("\nStarting Training...")

model=YOLO("yolo11n.pt")

model.train(

    data=DATA_YAML,

    epochs=30,

    imgsz=640,

    batch=16,

    device=DEVICE,

    workers=2,

    project=RUNS,

    name="human_detector",

    pretrained=True,

    patience=10,

    verbose=True

)

# ============================================================
# STEP 16 : LOAD BEST MODEL
# ============================================================

BEST_MODEL=RUNS+"/human_detector/weights/best.pt"

if not os.path.exists(BEST_MODEL):
    raise Exception("best.pt not found")

human_model=YOLO(BEST_MODEL)

print("\nBest Model Loaded")

# ============================================================
# STEP 17 : VALIDATE
# ============================================================

