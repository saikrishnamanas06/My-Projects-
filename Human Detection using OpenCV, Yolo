# ============================================================
# STEP 6 : CLASS DISTRIBUTION
# ============================================================

counts={}

for img in images:
    parent=img.parent.name
    counts[parent]=counts.get(parent,0)+1

print("\nDataset Distribution")

for k,v in counts.items():
