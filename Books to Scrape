)

st.sidebar.info(
    "For this project, use Books to Scrape. "
    "It is designed specifically for scraping practice."
)


# ============================================================
# SCRAPE FUNCTION
# ============================================================

def scrape_books(base_url, total_pages):

    session = requests.Session()

    session.headers.update({
        "User-Agent":
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 "
        "(KHTML, like Gecko) "
        "Chrome/120.0 Safari/537.36"
    })

    records = []

    progress = st.progress(0)

    status = st.empty()

    for page_number in range(1, total_pages + 1):

        # ----------------------------------------------------
        # CREATE URL
        # ----------------------------------------------------

        if page_number == 1:

            page_url = base_url

        else:

            page_url = urljoin(
                base_url,
                f"catalogue/page-{page_number}.html"
            )


        status.info(
            f"🔎 Scraping page "
            f"{page_number} / {total_pages}"
        )


        # ----------------------------------------------------
        # REQUEST WEBSITE
        # ----------------------------------------------------

        try:

            response = session.get(
                page_url,
                timeout=20
            )

        except requests.exceptions.Timeout:

            st.warning(
                f"Timeout on page {page_number}"
            )

            continue

        except requests.exceptions.ConnectionError:

            st.warning(
                f"Connection error on page {page_number}"
            )

            continue

        except requests.exceptions.RequestException as error:

            st.warning(
                f"Request error: {error}"
            )

            continue


        # ----------------------------------------------------
        # HTTP STATUS
        # ----------------------------------------------------

        if response.status_code != 200:

            st.warning(
                f"Page {page_number}: "
                f"HTTP {response.status_code}"
            )

            continue


        # ----------------------------------------------------
        # PARSE HTML
        # ----------------------------------------------------

        soup = BeautifulSoup(
            response.text,
            "html.parser"
        )


        # ----------------------------------------------------
        # FIND PRODUCTS
        # ----------------------------------------------------

        books = soup.select(
            "article.product_pod"
        )


        # ----------------------------------------------------
        # EXTRACT DATA
        # ----------------------------------------------------

        for book in books:

            # ================================================
            # TITLE
            # ================================================

            title_element = book.select_one(
                "h3 a"
            )

            if title_element:

                title = title_element.get(
                    "title",
                    "Unknown"
                ).strip()

            else:

                title = "Unknown"


            # ================================================
            # PRICE
            # ================================================

            price_element = book.select_one(
                ".price_color"
            )

            if price_element:

                price_text = price_element.get_text(
                    strip=True
                )

            else:

                price_text = "£0.00"


            # ================================================
            # RATING
            # ================================================

            rating_element = book.select_one(
                "p.star-rating"
            )

            rating = 0

            if rating_element:

                classes = rating_element.get(
                    "class",
                    []
                )

                rating_map = {
                    "One": 1,
                    "Two": 2,
                    "Three": 3,
                    "Four": 4,
                    "Five": 5
                }

                for rating_name, rating_value in (
                    rating_map.items()
                ):

                    if rating_name in classes:

                        rating = rating_value

                        break


            # ================================================
            # AVAILABILITY
            # ================================================

            availability_element = (
                book.select_one(
                    ".availability"
                )
            )

            if availability_element:

                availability = (
                    availability_element
                    .get_text(
                        " ",
                        strip=True
                    )
                )

            else:

                availability = "Unknown"


            # ================================================
            # BOOK URL
            # ================================================

            link_element = book.select_one(
                "h3 a"
            )

            if link_element:

                relative_url = link_element.get(
                    "href"
                )

                book_url = urljoin(
                    page_url,
                    relative_url
                )

            else:

                book_url = ""


            # ================================================
            # STORE RECORD
            # ================================================

            records.append({

                "Title": title,

                "Price": price_text,

                "Rating": rating,

                "Availability": availability,

                "URL": book_url

            })


        # ----------------------------------------------------
        # PROGRESS
        # ----------------------------------------------------

        progress.progress(
            page_number / total_pages
        )


        # ----------------------------------------------------
        # POLITE DELAY
        # ----------------------------------------------------

        time.sleep(0.5)


    progress.empty()

    status.success(
        "✅ Scraping completed!"
    )

    return pd.DataFrame(records)


# ============================================================
# SCRAPE BUTTON
# ============================================================

if st.sidebar.button(
    "🚀 START SCRAPING",
    use_container_width=True
):

    # --------------------------------------------------------
    # VALIDATE URL
    # --------------------------------------------------------

    if not website_url.startswith(
        ("http://", "https://")
    ):

        st.error(
            "Please enter a valid URL."
        )

        st.stop()


    # --------------------------------------------------------
    # START SCRAPING
    # --------------------------------------------------------

    with st.spinner(
        "Scraping website..."
    ):

        df = scrape_books(
            website_url,
            pages
        )


    # --------------------------------------------------------
    # CHECK RESULT
    # --------------------------------------------------------

    if df.empty:

        st.error(
            "No data was found."
        )

        st.stop()


    # ========================================================
    # DATA CLEANING
    # ========================================================

    # Remove duplicates

    df = df.drop_duplicates(
        subset=["Title"]
    )


    # --------------------------------------------------------
    # PRICE
    # --------------------------------------------------------

    df["Price"] = (
        df["Price"]
        .astype(str)
        .str.replace(
            "£",
            "",
            regex=False
        )
        .str.strip()
    )

    df["Price"] = pd.to_numeric(
        df["Price"],
        errors="coerce"
    )


    # --------------------------------------------------------
    # RATING
    # --------------------------------------------------------

    df["Rating"] = pd.to_numeric(
        df["Rating"],
        errors="coerce"
    )


    # --------------------------------------------------------
    # MISSING VALUES
    # --------------------------------------------------------

    df["Price"] = df["Price"].fillna(0)

    df["Rating"] = df["Rating"].fillna(0)


    # --------------------------------------------------------
    # RESET INDEX
    # --------------------------------------------------------

    df = df.reset_index(
        drop=True
    )


    # --------------------------------------------------------
    # STORE DATA
    # --------------------------------------------------------

    st.session_state["df"] = df


# ============================================================
# DISPLAY RESULTS
# ============================================================

if "df" in st.session_state:

    df = st.session_state["df"]


    # ========================================================
    # SUCCESS
    # ========================================================

    st.success(
        f"🎉 Successfully scraped "
        f"{len(df)} books!"
    )


    # ========================================================
    # KPI CARDS
    # ========================================================

    col1, col2, col3, col4 = st.columns(4)


    with col1:

        st.metric(
            "📚 Total Books",
