        )


    with col2:

        st.metric(
            "💰 Average Price",
            f"£{df['Price'].mean():.2f}"
        )


    with col3:

        st.metric(
            "⭐ Average Rating",
            f"{df['Rating'].mean():.2f}"
        )


    with col4:

        st.metric(
            "💎 Highest Price",
            f"£{df['Price'].max():.2f}"
        )


    st.divider()


    # ========================================================
    # SEARCH
    # ========================================================

    st.subheader("🔍 Search Books")

    search_text = st.text_input(
        "Search by title",
        placeholder="Example: Python..."
    )


    if search_text:

        filtered_df = df[
            df["Title"]
            .str.contains(
                search_text,
                case=False,
                na=False
            )
        ]

    else:

        filtered_df = df


    st.write(
        f"Showing {len(filtered_df)} records"
    )


    # ========================================================
    # DATA TABLE
    # ========================================================

    st.subheader(
        "📊 Scraped Dataset"
    )

    st.dataframe(
        filtered_df,
        use_container_width=True,
        hide_index=True,
        column_config={

            "URL": st.column_config.LinkColumn(
                "Book URL"
            ),

            "Price": st.column_config.NumberColumn(
                "Price (£)",
                format="£%.2f"
            ),

            "Rating": st.column_config.NumberColumn(
                "Rating",
                format="%d ⭐"
            )

        }
    )


    # ========================================================
    # PRICE ANALYSIS
    # ========================================================

    st.subheader(
        "📈 Price Analysis"
    )


    expensive = (
        df
        .sort_values(
            "Price",
            ascending=False
        )
        .head(10)
    )


    st.bar_chart(
        expensive.set_index(
            "Title"
        )["Price"]
    )


    # ========================================================
    # RATING ANALYSIS
    # ========================================================

    st.subheader(
        "⭐ Rating Distribution"
    )


    rating_data = (
        df["Rating"]
        .value_counts()
        .sort_index()
    )


    st.bar_chart(
        rating_data
    )


    # ========================================================
    # PRICE STATISTICS
    # ========================================================

    st.subheader(
        "📊 Price Statistics"
    )


    statistics = pd.DataFrame({

        "Metric": [
            "Minimum Price",
            "Maximum Price",
            "Average Price",
            "Median Price"
        ],

        "Value (£)": [

            df["Price"].min(),

            df["Price"].max(),

            df["Price"].mean(),

            df["Price"].median()

        ]

    })


    st.dataframe(
        statistics,
        use_container_width=True,
        hide_index=True
    )


    # ========================================================
    # TOP BOOKS
    # ========================================================

    st.subheader(
        "🏆 Top 10 Most Expensive Books"
    )


    top_books = (
        df
        .sort_values(
            "Price",
            ascending=False
        )
        .head(10)
        [["Title", "Price", "Rating", "Availability"]]
    )


    st.dataframe(
        top_books,
        use_container_width=True,
        hide_index=True
    )


    # ========================================================
    # DOWNLOAD CSV
    # ========================================================

    st.subheader(
        "📥 Download Dataset"
    )


    csv_data = df.to_csv(
        index=False
    ).encode(
        "utf-8"
    )


    st.download_button(
        label="📥 Download CSV",
        data=csv_data,
        file_name="books_scraped_data.csv",
        mime="text/csv",
        use_container_width=True
    )


    # ========================================================
    # TARGET WEBSITE
    # ========================================================

    st.divider()

    st.subheader(
        "🌐 Target Website"
    )


    st.link_button(
        "Open Books to Scrape",
        website_url,
        use_container_width=True
    )


else:

    # ========================================================
    # INITIAL SCREEN
    # ========================================================

    st.info(
        "👈 Configure the website in the sidebar "
        "and click **START SCRAPING**."
    )


# ============================================================
# FOOTER
# ============================================================

st.divider()

st.caption(
    "Web Scraping Analytics Project | "
    "Python + Requests + BeautifulSoup + Pandas + Streamlit"
)

'''


