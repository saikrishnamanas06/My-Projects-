# 8. START CLOUDFLARE TUNNEL
# ============================================================

print()
print("⏳ Creating public URL...")


cloudflare_process = subprocess.Popen(
    [
        "./cloudflared",
        "tunnel",
        "--url",
        "http://127.0.0.1:8501"
    ],

    stdout=subprocess.PIPE,

    stderr=subprocess.STDOUT,

    text=True
)


# ============================================================
# 9. FIND CLOUDFLARE URL
# ============================================================

public_url = None


for _ in range(40):

    line = cloudflare_process.stdout.readline()


    if line:

        line = line.strip()

        print(line)


        if "trycloudflare.com" in line:

            parts = line.split()

            for part in parts:

                if (
                    part.startswith("https://")
                    and
                    "trycloudflare.com" in part
                ):

                    public_url = part

                    break


        if public_url:

            break


    time.sleep(1)


