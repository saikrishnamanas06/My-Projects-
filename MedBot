# 18. SEND MESSAGE
# ============================================================

def send_message(button=None):

    global message_count

    question = message_box.value.strip()

    if not question:

        return

    # Clear input
    message_box.value = ""

    # Disable send button
    send_button.disabled = True

    # Show user question
    show_user_message(question)

    # Loading message
    with chat_output:

        loading = widgets.HTML(
            value="""
            <div style="
                padding:10px;
                color:#666;
                font-style:italic;
            ">
                🩺 MedBot is thinking...
            </div>
            """
        )

        display(loading)

    try:

        answer = generate_response(question)

        # Remove loading
        loading.value = ""

        # Show answer
        show_bot_message(answer)

        # Update counter
        message_count += 1

        counter.value = (
            f"<b>Messages:</b> {message_count}"
        )

    except Exception as e:

        loading.value = ""

        show_bot_message(
            f"⚠️ Error: {str(e)}"
        )

    finally:

        send_button.disabled = False


